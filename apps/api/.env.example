# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=openai/gpt-oss-120b:free
# Optional: custom base URL (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: app URL for attribution
# APP_URL=http://localhost:5173
# Frontend origin allowed by API in production
# CORS_ORIGIN=http://localhost:3000

# NVIDIA NIM Configuration (optional — use both providers seamlessly)
# Set this if you also want to use NVIDIA NIM models.
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Doc Engine (Python FastAPI co-proceso en el mismo container)
# Solo cambia esta URL si marginas el servicio en otro host/puerto.
DOC_ENGINE_URL=http://127.0.0.1:8788

