# ── Proveedores de IA (también se configuran desde la interfaz, que tiene prioridad) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Modelo inicial de OpenRouter (cada proveedor recuerda su propio modelo)
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# NVIDIA NIM (opcional)
# NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── ChatGPT (plan de suscripción, se activa desde la interfaz) ──
# Puerto preferido del callback 127.0.0.1 (si está ocupado se usa otro)
# TASKY_CHATGPT_CALLBACK_PORT=1455
# Carpeta de credenciales (por defecto <STORAGE_ROOT>/credentials/chatgpt)
# TASKY_CHATGPT_CREDENTIALS_DIR=
# Permitir el login dentro de un contenedor (solo con network_mode: host)
# TASKY_CHATGPT_ALLOW_CONTAINER=1

# ── Servidor ──
# PORT=8787
# APP_URL=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000
# AI_RATE_LIMIT_MAX=120
# RATE_LIMIT_MAX=600

# ── Contexto y modelos ──
# Tope de tokens de entrada por mensaje (se ajusta además a la ventana del modelo)
# TASKY_MAX_INPUT_TOKENS=100000
# Zona horaria para la fecha que ve la IA
# TASKY_TIMEZONE=America/Argentina/Buenos_Aires
# Corte si el modelo deja de transmitir (ms)
# TASKY_LLM_IDLE_MS=120000

# ── Doc Engine (CLI Python lanzado por proceso) ──
# PYTHON_BIN=python3
# DOCENGINE_TIMEOUT_MS=90000
