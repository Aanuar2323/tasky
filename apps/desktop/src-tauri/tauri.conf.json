{
  "productName": "Tasky",
  "version": "1.0.0",
  "identifier": "com.tasky.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node ../../scripts/prebuild-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Tasky",
        "label": "main",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 800,
        "center": true,
        "resizable": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/": "../dist/"
    },
    "externalBin": [
      "binaries/node"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "copyright": "",
    "category": "Productivity",
    "shortDescription": "Tasky - task manager with IA",
    "longDescription": "Tasky is a task management application with integrated AI. Not a generic chatbot — a work agent tied to a project and its functional areas.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}